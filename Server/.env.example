# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

API_GATEWAY_PORT=5000
AUTH_SERVICE_HTTP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Kafka used for campaign.scheduled events.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID_CAMPAIGN=campaign-service
KAFKA_CLIENT_ID_SCHEDULER=scheduler-service
KAFKA_CONSUMER_GROUP_ID=scheduler-consumer

# Redis used by BullMQ. Leave REDIS_PASSWORD empty for local Docker Redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
